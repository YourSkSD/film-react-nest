# Docker image owner (GitHub user/org for ghcr.io images)
OWNER=your-github-owner

# PostgreSQL superuser (created by the postgres image on first start)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=postgres

# Application database user/name (created by init scripts)
DB_USER=docker
DB_PASSWORD=change_me
DB_NAME=films

# Backend / TypeORM
DATABASE_DRIVER=postgres
BACKEND_PORT=3000

# pgAdmin login
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
